# Shared-session backend (Supabase)
# Copy to .env.local for local development. Vite exposes VITE_* values to the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy fallback only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new setups.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_SUPABASE_ANON_KEY
